<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>
            {% block title %}Liam's Listeners{% endblock %}
        </title>

        {# Minimal default styling from SimpleCSS #}
        <link rel="stylesheet" href="https://cdn.simplecss.org/simple.min.css">

        {% block stylesheets %}{% endblock %}
        {% block javascripts %}{% endblock %}
    </head>

    <body>

        <header>
            <h1 style="margin-bottom:0;">🎧 Liam’s Listeners (LL)</h1>
            <p style="margin-top:0; color:#777;">
                Discover, review and explore music together!
            </p>

            <nav style="display:flex; gap:1rem; align-items:center; justify-content:space-between;">

                <div style="display:flex; gap:1rem; align-items:center;">
                    <a href="{{ path('home') }}">Home</a>
                    <a href="{{ path('album_index') }}">Albums</a>
                    <a href="{{ path('about') }}">About</a>
                </div>

                <div style="display:flex; gap:1rem; align-items:center;">
                    {% if app.user %}
                        <span>Logged in as {{ app.user.displayName }}</span>
                        <a href="{{ path('logout') }}">Logout</a>

                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('album_new') }}" style="font-weight:bold;">
                                ➕ Add Album
                            </a>
                        {% endif %}
                    {% else %}
                        <a href="{{ path('register') }}">Register</a>
                        <a href="{{ path('login') }}">Login</a>
                    {% endif %}
                </div>

            </nav>
        </header>

        <main>
            {% block body %}{% endblock %}
        </main>

        <footer style="margin-top: 3rem; text-align: center; opacity: 0.8;">
            <p>
                © {{ "now"|date("Y") }} Liam's Listeners (LL) —
                Built with Symfony & Doctrine ORM.
            </p>
        </footer>

    </body>
</html>
