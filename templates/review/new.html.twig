{% extends 'base.html.twig' %}

{% block title %}Write a review{% endblock %}

{% block body %}
<div style="max-width: 900px; margin: 2rem auto; color: #f5f5f5;">
    <h1 style="font-size: 2.5rem; margin-bottom: 1rem;">
        Write a review for {{ album.title }}
    </h1>

    <p style="margin-bottom: 2rem; font-size: 1.1rem; color: #cccccc;">
        Artist: <strong>{{ album.artist }}</strong>
    </p>

    {{ form_start(form) }}
        <div style="margin-bottom: 1rem;">
            {{ form_label(form.rating) }}
            {{ form_widget(form.rating, { attr: { class: 'input' } }) }}
            {{ form_errors(form.rating) }}
        </div>

        <div style="margin-bottom: 1rem;">
            {{ form_label(form.title) }}
            {{ form_widget(form.title, { attr: { class: 'input' } }) }}
            {{ form_errors(form.title) }}
        </div>

        <div style="margin-bottom: 1rem;">
            {{ form_label(form.body) }}
            {{ form_widget(form.body, { attr: { rows: 4, class: 'input' } }) }}
            {{ form_errors(form.body) }}
        </div>

        <button type="submit" style="background:#ffb300; border:none; padding:0.6rem 1.5rem; cursor:pointer; font-weight:bold;">
            Submit
        </button>
    {{ form_end(form) }}

    <p style="margin-top: 1.5rem;">
        <a href="{{ path('album_show', { id: album.id }) }}" style="color:#ffb300;">
            Back to album
        </a>
    </p>
</div>
{% endblock %}
